{
  "name": "@sentrix-labs/canonical-contracts",
  "version": "1.1.0",
  "description": "Canonical EVM contracts for Sentrix Chain (WSRX, Multicall3, SentrixSafe, TokenFactory). Typed ABIs + per-chain address registry for viem / ethers / wagmi.",
  "license": "BUSL-1.1",
  "homepage": "https://github.com/sentrix-labs/canonical-contracts",
  "repository": {
    "type": "git",
    "url": "https://github.com/sentrix-labs/canonical-contracts.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./abi/*": "./deployments/abi/*.json",
    "./deployments/*": "./deployments/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "deployments/",
    "contracts/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:sol": "forge build --sizes",
    "test:sol": "forge test -vvv",
    "abi": "./script/copy-abi.sh",
    "gen": "node scripts/gen-types.mjs",
    "build": "pnpm gen && tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@typechain/ethers-v6": "^0.5.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "keywords": [
    "sentrix",
    "sentrixchain",
    "evm",
    "solidity",
    "wsrx",
    "multicall",
    "safe",
    "canonical-contracts",
    "viem",
    "wagmi",
    "ethers",
    "blockchain"
  ]
}
